# =====================================================================
# Intelligent Document Research Assistant — Environment Configuration
# =====================================================================
# Copy this file to .env and supply your credentials:
#   cp .env.example .env
#
# Note: The platform includes built-in ChromaDB vector search and verified
# educational catalogs that operate seamlessly even without external API keys.
# =====================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
MAX_CONTENT_LENGTH_MB=50

# ---------------------------------------------------------------------
# 1. Google Gemini API Key (Optional)
# ---------------------------------------------------------------------
# Used for real-time generative RAG answering and paper summarization.
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# 2. YouTube Data API v3 Key (Optional)
# ---------------------------------------------------------------------
# Used to query live YouTube video lectures and tutorials for uploaded papers.
# Obtain a key from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project.
YOUTUBE_API_KEY=your_youtube_api_key_here

# ---------------------------------------------------------------------
# 3. OpenAI API Key (Optional)
# ---------------------------------------------------------------------
# Secondary LLM provider for GPT-4o-mini summarization and Q&A.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------
# 4. Storage & ChromaDB Settings
# ---------------------------------------------------------------------
CHROMA_DIR=backend/data/chroma_db
UPLOADS_DIR=backend/data/uploads
DOCS_METADATA_FILE=backend/data/documents.json
SETTINGS_FILE=backend/data/settings.json
